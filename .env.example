# ============================================================
# Telegram Userbot (для чтения сообщений из групп)
# Получить: my.telegram.org → API Development Tools
# ============================================================
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890
TELEGRAM_PHONE=+79001234567
TELEGRAM_SESSION_NAME=ragazzi_userbot

# ============================================================
# Telegram Bot (для админ-панели)
# Получить: @BotFather → /newbot
# ============================================================
TELEGRAM_BOT_TOKEN=1234567890:AABBCCDDEEFFaabbccddeeff1234567890

# ============================================================
# Группы источники заказов (ID групп через запятую)
# Чтобы узнать ID: переслать сообщение из группы боту @userinfobot
# ============================================================
ORDER_SOURCE_GROUPS=-1001234567890,-1009876543210

# ============================================================
# Администраторы и менеджеры (Telegram ID через запятую)
# ============================================================
ADMIN_IDS=123456789,987654321
MANAGER_IDS=111222333,444555666

# Группа менеджеров (для дубликатов, ошибок, проблемных заказов)
MANAGER_GROUP_ID=-1001111111111

# ============================================================
# Geo API (для определения ближайшего филиала и проверки адресов)
# Рекомендуется 2GIS: https://dev.2gis.com/
# ============================================================
GEO_PROVIDER=2gis
TWOGIS_API_KEY=your_2gis_api_key_here
YANDEX_MAPS_API_KEY=your_yandex_api_key_here

# ============================================================
# Зона доставки (центр Владивостока + радиус)
# ============================================================
DELIVERY_CENTER_LAT=43.1155
DELIVERY_CENTER_LON=131.8855
DELIVERY_MAX_RADIUS_KM=50.0

# ============================================================
# База данных
# SQLite (по умолчанию) или PostgreSQL
# ============================================================
DATABASE_URL=sqlite+aiosqlite:///./ragazzi.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ragazzi

# ============================================================
# Обработка заказов
# ============================================================
DUPLICATE_WINDOW_MINUTES=60
ORDER_PROCESSING_WORKERS=3

# ============================================================
# Логирование
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=logs/ragazzi.log
